!% -v3
!% $SERIAL=260830

! tclzmachine-v3.inf
!
! Compact, repository-owned Version 3 integration fixture for tclzmachine.
! It intentionally does not include the modern Inform standard library, which
! requires V5+ features. Instead it uses ordinary Inform control flow and a
! small set of direct Z-machine opcodes so the fixture exercises the actual V3
! VM model without depending on copyrighted or external story files.
!
! The first character of each input line is enough to select most commands;
! "save" and "south" are distinguished by the second character. The script
! tests line input, calls, globals, V3 object-tree layout, insert_obj, branches,
! Quetzal save/restore branch semantics, canonical text output, and persistent
! state across Tcl calls.

Array InputBuffer -> 34;
Global RoomState = 0;

Object TestChamber "test chamber";
Object -> Lamp "brass lamp";
Object NorthRoom "north room";
Object Player "player";

[ ShowLocation;
    if (RoomState == 0) {
        print "V3 Test Chamber^A compact Version 3 test chamber.^";
    } else {
        print "V3 North Room^A second Version 3 room.^";
    }
];

[ ShowInventory p;
    @get_parent Lamp -> p;
    if (p == Player)
        print "You are carrying the brass lamp.^";
    else
        print "You are carrying nothing.^";
];

! V1-V3 save is a branch opcode. A successful restore resumes at this saved
! branch record and takes the successful branch again, restoring this routine's
! frame as part of the state of play.
[ DoSave;
    @save ?SaveSucceeded;
    print "Save failed.^";
    rfalse;

.SaveSucceeded;
    print "Save completed.^";
    rtrue;
];

! On a successful V3 restore control never reaches RestoreSucceeded: execution
! resumes at the old save opcode instead. The branch exists only because the
! opcode encoding requires one; a failed restore falls through normally.
[ DoRestore;
    @restore ?RestoreSucceeded;
    print "Restore failed.^";
    rfalse;

.RestoreSucceeded;
    print "Unexpected restore branch.^";
    rfalse;
];

[ Main c c2 p first_child;
    print "tclzmachine V3 fixture ready.^";

    @get_child TestChamber -> first_child ?TreePresent;
    print "V3 object tree failed.^";
    jump MainLoop;

.TreePresent;
    if (first_child == Lamp)
        print "V3 object tree ready.^";
    else
        print "V3 object tree failed.^";

.MainLoop;
    for (::) {
        print "> ";
        InputBuffer->0 = 30;
        @sread InputBuffer 0;
        c = InputBuffer->1;
        c2 = InputBuffer->2;

        if (c == 'l') {
            ShowLocation();
        } else if (c == 't') {
            @get_parent Lamp -> p;
            if (p == Player) {
                print "You already have the lamp.^";
            } else {
                @insert_obj Lamp Player;
                print "Taken.^";
            }
        } else if (c == 'd') {
            @get_parent Lamp -> p;
            if (p == Player) {
                @insert_obj Lamp TestChamber;
                print "Dropped.^";
            } else {
                print "You are not carrying the lamp.^";
            }
        } else if (c == 'i') {
            ShowInventory();
        } else if (c == 'n') {
            RoomState = 1;
            ShowLocation();
        } else if (c == 's') {
            if (c2 == 'a') {
                DoSave();
            } else if (c2 == 'o') {
                RoomState = 0;
                ShowLocation();
            } else {
                print "Use SAVE or SOUTH.^";
            }
        } else if (c == 'r') {
            DoRestore();
        } else if (c == 'q') {
            @quit;
        } else {
            print "Try LOOK, TAKE, DROP, INVENTORY, NORTH, SOUTH, SAVE, RESTORE, or QUIT.^";
        }
    }
];
