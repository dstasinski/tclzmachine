!% -v5
!% $SERIAL=260819

! tclzmachine-test.inf
!
! Purpose-built integration story for the tclzmachine interpreter. The game is
! intentionally small and deterministic so scripted conversations can test
! parser input, object movement, properties, routine calls, arithmetic/state,
! room movement, inventory, scoring, and ordinary text output without relying
! on copyrighted commercial story files.
!
! The current standard Inform 6 library requires Z-machine V5 or later. GitHub
! Actions therefore builds this standard-library fixture as V5. A separate V3
! fixture will use a V3-capable library/toolchain rather than falsely compiling
! this source against a library whose own opcodes require V5.
!
! Keep the fixed SERIAL above so a rebuild is byte-stable when the source and
! compiler/library toolchain are unchanged.

Constant Story "tclzmachine Test Adventure";
Constant Headline "^A deterministic Z-machine integration fixture.^";
Constant MAX_SCORE 10;

Include "Parser";
Include "VerbLib";

Object TestLab "Test Lab"
  with description
      "You are in a small test laboratory. A doorway leads north.",
       n_to LabDoor,
  has light;

Object -> Lamp "brass lamp"
  with name 'brass' 'lamp',
       description "The brass lamp is plain, sturdy, and made for testing.";

Object NorthRoom "North Room"
  with description
      "This is the north room. The test laboratory is south.",
       s_to TestLab,
  has light;

Object LabDoor "north doorway"
  with name 'north' 'doorway' 'door',
       description "It is an ordinary open doorway.",
       door_to NorthRoom,
       door_dir n_to,
       found_in TestLab,
  has scenery open door;

[ Initialise;
    location = TestLab;
    score = 0;
    print "tclzmachine integration fixture ready.^";
];

Include "Grammar";
